{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @cyber-guardians/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://breachsphire-api.onrender.com/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
