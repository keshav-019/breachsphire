{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @cyber-guardians/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://vanisher.projectyourown.com:3001/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
