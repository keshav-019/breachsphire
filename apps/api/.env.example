# Copy to .env and fill in with your Supabase project URL
# (Project Settings -> API -> Project URL, either cloud or local `pnpm db:status`).
#
# No secret needed for auth: the guard verifies sessions against Supabase's
# public JWKS endpoint (derived from this URL), not a shared secret.
SUPABASE_URL=

# Session pooler connection string works fine here (Database Settings ->
# Connect -> Session pooler). Local Supabase: use the db_url from
# `pnpm db:status`. The deployed API (Render) runs this same long-lived
# process model, not serverless, so this exact value is reused there too —
# see docs/13-deployment-vercel.md.
DATABASE_URL=
