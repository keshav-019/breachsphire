# Copy to .env and fill in.

# Postgres connection string. Local dev database (see README Quickstart):
#   postgres://breachsphire:dev@localhost:5432/breachsphire
# The VM's database (production data!) needs TLS verification:
#   postgres://breachsphire:<password>@vanisher.projectyourown.com:5432/breachsphire?sslmode=verify-full
#   plus NODE_EXTRA_CA_CERTS=<path to ca.crt>
# On the VM itself this is set by deploy/docker-compose.yaml.
DATABASE_URL=

# Signs the API's access tokens (HS256). At least 32 random characters;
# generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

PORT=3001
