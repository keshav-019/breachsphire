# Copy to .env and fill in with your Supabase project URL
# (Project Settings -> API -> Project URL, either cloud or local `pnpm db:status`).
#
# No secret needed for auth: the guard verifies sessions against Supabase's
# public JWKS endpoint (derived from this URL), not a shared secret.
SUPABASE_URL=

# Local dev (`pnpm dev:api`, a long-running process): Session pooler
# connection string works fine (Database Settings -> Connect -> Session
# pooler). Local Supabase: use the db_url from `pnpm db:status`.
#
# Vercel deploy: use the Transaction pooler string instead (Database
# Settings -> Connect -> Transaction pooler, port 6543) — serverless
# functions open many short-lived connections rather than one long-lived
# one, and the transaction pooler is built for exactly that. See
# docs/13-deployment-vercel.md.
DATABASE_URL=
