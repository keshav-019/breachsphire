# Copy to .env and fill in.

# Postgres connection string. Local dev against the VM database:
#   postgres://breachsphire:<password>@vanisher.projectyourown.com:5432/breachsphire?sslmode=verify-full
# with NODE_EXTRA_CA_CERTS pointing at the CA cert (below). Inside the
# docker-compose deployment this is set by docker-compose.yaml instead.
DATABASE_URL=
# NODE_EXTRA_CA_CERTS=../../certs/ca.crt

# Signs the API's access tokens (HS256). At least 32 random characters;
# generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

PORT=3001
