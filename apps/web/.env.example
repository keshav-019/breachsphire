# Copy to .env and fill in.

# Where the app calls the API (auth + game data). Set it to call the API
# directly, e.g. the VM deployment:
#   VITE_API_BASE_URL=http://vanisher.projectyourown.com:3001
# Leave it empty to go through the /api reverse proxy instead (the Vite dev
# server proxies to http://localhost:3001; vercel.json rewrites in production).
VITE_API_BASE_URL=
