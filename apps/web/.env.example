# Copy to .env and fill in.
#
# Cloud Supabase (default path): Project Settings -> API -> Project URL / anon key.
#
# Local Supabase (alternative, needs Docker): run `pnpm db:start` then `pnpm db:status`
# and use http://127.0.0.1:54321 with the printed anon key instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
