# Credentials for the persistent e2e test account. This user already exists
# in Supabase (created once via the real signup flow) — tests log into it
# repeatedly rather than creating a fresh account each run. Copy this to
# .env.test and fill in the real values (ask a teammate, or create your own
# test account and update these).
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_DISPLAY_NAME=
